rules_version = '2';

// ============================================================
//  NoteBazaar — Firebase Storage Security Rules
//  ⚠️ BEFORE PUBLISHING: replace REPLACE_WITH_ADMIN_EMAIL
//     with your real login email (same as ADMIN_EMAILS in
//     js/firebase-config.js).
// ============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Note PDFs — logged-in users can read, only admin can upload/delete
    match /notes/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null &&
                      request.auth.token.email in ['REPLACE_WITH_ADMIN_EMAIL'];
    }

    // Everything else: denied
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
